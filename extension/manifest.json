{
  "manifest_version": 3,
  "name": "HTML Tools",
  "short_name": "HTML Tools",
  "version": "0.0.0",
  "description": "Local browser tools. JSON, CSV, regex, hashes, QR, zip, and more. Nothing leaves this device.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HTML Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
